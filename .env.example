# Database Configuration (Optional - for persistence)
DATABASE_URL=mysql://shopify_admin:YourStrongPassword123!@localhost:3306/shopify_insights
REDIS_URL=redis://localhost:6379

# Application Settings
APP_NAME=Shopify Store Insights Fetcher
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=False

# Scraping Configuration
USER_AGENT=ShopifyInsightsFetcher/1.0
REQUEST_TIMEOUT=30
MAX_RETRIES=3
CONCURRENT_REQUESTS=10
HEADLESS_BROWSER=True

# Data Extraction Limits
MAX_PRODUCTS=100
MAX_HERO_PRODUCTS=5
MAX_FAQS=20
MAX_SOCIAL_HANDLES=10
MAX_IMPORTANT_LINKS=15

# Content Length Limits
MAX_POLICY_LENGTH=5000
MAX_BRAND_CONTEXT_LENGTH=2000
MAX_FAQ_ANSWER_LENGTH=500

# Rate Limiting
REQUESTS_PER_MINUTE=60
REQUESTS_PER_HOUR=1000

# LLM Configuration (Optional but recommended for better extraction)
# Choose ONE of the following LLM providers:

# Google Gemini Configuration (Recommended - Free tier available)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro
GEMINI_MAX_TOKENS=1000
GEMINI_TEMPERATURE=0.3

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.3

# Anthropic Configuration
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
ANTHROPIC_MAX_TOKENS=1000

# LLM General Settings
USE_LLM_FOR_EXTRACTION=True
LLM_PROVIDER=gemini  # Options: gemini, openai, anthropic, none
LLM_FALLBACK_ENABLED=True

# Competitor Analysis (Bonus Feature)
ENABLE_COMPETITOR_ANALYSIS=True
MAX_COMPETITORS=5

# Search APIs for Fast Competitor Discovery
# Option 1: SerpAPI (fastest, paid) - Get key from https://serpapi.com
SERPAPI_KEY=

# Option 2: Google Custom Search (free tier available)
# Get from https://developers.google.com/custom-search/v1/introduction
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Option 3: RapidAPI Search (many options)
RAPIDAPI_KEY=

# Caching Configuration
CACHE_ENABLED=True
CACHE_TTL=3600  # Cache time-to-live in seconds (1 hour)
CACHE_MAX_SIZE=1000  # Maximum number of cached items

# API Security
API_KEY=  # Optional API key for authentication
ALLOWED_ORIGINS=*  # CORS settings
ENABLE_CORS=True

# Performance Settings
ENABLE_ASYNC=True
WORKER_COUNT=4
CONNECTION_POOL_SIZE=10

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log
ENABLE_FILE_LOGGING=False